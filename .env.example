# Copy this file to .env and edit values.
#
# ── Docker setup ──────────────────────────────────────────────────────────────
# Absolute host path to the project root (forward slashes on Windows).
# Used by the Kestra Docker runner to bind-mount the project into task containers.
#   Windows example:  C:/Users/yourname/projects/london-cycling-safety
#   Linux/Mac example: /home/yourname/projects/london-cycling-safety
LONDON_PROJECT_PATH=

# Absolute host path to the credentials/ directory.
# Used by the Kestra Docker runner to mount credentials into task containers.
CREDENTIALS_PATH=

# ── Database ──────────────────────────────────────────────────────────────────
# Local / host runs: leave empty to use the default (london_cycling.duckdb).
# Docker dev: overridden automatically to /data/london_cycling.duckdb via
#             docker-compose.dev.yml – you do NOT need to set this here.
DUCKDB_PATH=

# TFL Cycling ingestion
# How many weekly files to ingest from TFL (each ~1 week of journeys)
TFL_N_FILES=

# UK road accident ingestion years (comma-separated)
ACCIDENT_YEARS=2023,2024

# Spatial analysis
# Radius in metres around each bike station to search for accidents
BLACKSPOT_RADIUS_M=

# Dashboard
STREAMLIT_PORT=8501

# ── BigQuery / Google Cloud (production target) ────────────────────────────────
# Place your service-account JSON key inside the credentials/ folder.
# That directory is gitignored — never commit the key file.
#
# The path below is the location INSIDE the Kestra Docker container
# (the credentials/ folder is mounted at /credentials — see docker-compose.local.yml).
GOOGLE_APPLICATION_CREDENTIALS=

# dbt BigQuery target (used by profiles.yml prod target)
GCP_PROJECT_ID=
GCP_BQ_DATASET=
GCP_BQ_LOCATION=
# GCS bucket for Kestra artefact storage (must be globally unique)
GCP_BUCKET_NAME=
 
# dlt BigQuery destination config (used by ingestion scripts)
# Must match GCP_BQ_LOCATION so raw dataset lands in the same region as dbt expects
DESTINATION__BIGQUERY__PROJECT_ID=
DESTINATION__BIGQUERY__LOCATION=
DESTINATION__BIGQUERY__CREDENTIALS__CLIENT_EMAIL=

# ── Streamlit dashboard backend ────────────────────────────────────────────────
# Set to 'prod' to read from BigQuery (production pipeline output).
# Set to 'dev'  to read from local DuckDB file (default).
DASHBOARD_TARGET=prod