# ── Secrets & credentials ─────────────────────────────────────────────────────
.env
kestra/.kestra.env
*.json.key
*service_account*.json
*credentials*.json
gcp_key*.json
# any SA key placed in the credentials/ directory
credentials/*.json

# ── DuckDB databases (can be large, always regenerated by the pipeline) ───────
*.duckdb
*.duckdb.wal

# ── dbt generated artifacts ───────────────────────────────────────────────────
target/
dbt_packages/
dbt_internal_packages/
logs/
package-lock.yml

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
.Python
.venv/
venv/
env/
*.egg-info/
dist/
build/
.eggs/
pip-wheel-metadata/

# ── Virtual environments ───────────────────────────────────────────────────────
.venv
venv
env

# ── Jupyter ───────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── OS generated ──────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ── IDE / editor ──────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── Pipeline run logs and temp outputs ────────────────────────────────────────
*.log
pipeline_run.log
tfl_test.log
accidents_test.log
debug_out.txt
err.txt

# ── Downloaded data (regenerated on each run) ─────────────────────────────────
data/
raw_data/

# ── Kestra local storage volume (Docker named volume, not in repo) ────────────
kestra_data/

# ── dlt internal state ────────────────────────────────────────────────────────
.dlt/

# ── Streamlit cache ───────────────────────────────────────────────────────────
.streamlit/cache/

# ── dbt user-local state (machine-specific UUID, not project code) ────────────
.user.yml

# ── One-off debug / utility scripts (not part of the pipeline) ───────────────
check_db.py

# ── Duplicate plain-text documentation (README.md is the canonical source) ───
README.txt
