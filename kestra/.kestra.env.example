# ==============================================================================
# Kestra environment file – London Cycling Safety
# ==============================================================================
# Copy this file to .kestra.env and fill in values for your machine.
# .kestra.env is loaded by docker-compose.yml via env_file.
# It is gitignored – NEVER commit .kestra.env.
#
# Values are interpolated by Docker Compose into KESTRA_CONFIGURATION,
# which means the paths you set here become Docker bind-mount specs that
# Kestra passes to every task container it spawns.
# ==============================================================================

# ── Project paths ─────────────────────────────────────────────────────────────
# Absolute path to the london-cycling-safety project root on your machine.
# Use forward slashes on Windows (Docker Desktop converts them).
#   Windows example:  C:/Users/yourname/projects/london-cycling-safety
#   Linux/Mac example: /home/yourname/projects/london-cycling-safety
LONDON_PROJECT_PATH=C:/path/to/london-cycling-safety

# Absolute path to the directory that contains your GCP service-account JSON.
# Must contain the .json key file referenced in CREDENTIALS_FILENAME (below).
CREDENTIALS_PATH=C:/path/to/london-cycling-safety/credentials

# ── GCP / BigQuery ────────────────────────────────────────────────────────────
# Filename of the GCP service-account JSON key (file must exist in CREDENTIALS_PATH).
CREDENTIALS_FILENAME=your-service-account-key.json

# GCP project ID
GCP_PROJECT_ID=your-gcp-project-id

# BigQuery dataset (dbt base prefix; actual datasets get suffixes like _staging, _marts)
GCP_BQ_DATASET=dbt_london_cycling

# BigQuery dataset location
GCP_BQ_LOCATION=EU
